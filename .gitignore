# ==========================================
# Sarathi Project - Git Ignore Rules
# Protects sensitive keys, environment files, and system artifacts
# ==========================================

# Environment variables & Private Keys
.env
.env.local
*.env
firebase-config.local.js
config.local.js

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
powershell.cmd
*.tmp
~$*


# Python artifacts (if any documentation scripts are run)
__pycache__/
*.py[cod]
*$py.class
