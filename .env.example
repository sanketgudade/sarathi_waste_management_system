# Sarathi Smart Waste Management - Environment Configuration Template
# Duplicate this file to .env or inject into window.__ENV__

# ==========================================
# Firebase Web App Credentials
# Obtain from: Firebase Console -> Project Settings -> General -> Your Apps
# ==========================================
FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==========================================
# Mapbox Public Access Token
# Obtain from: https://account.mapbox.com/access-tokens/
# ==========================================
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# ==========================================
# Application Settings
# ==========================================
APP_ENV=production
APP_NAME=Sarathi
APP_URL=https://sarathi-waste.web.app
